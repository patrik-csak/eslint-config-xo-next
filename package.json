{
	"name": "eslint-config-xo-next",
	"version": "0.3.0",
	"description": "ESLint shareable config for Next.js to be used with eslint-config-xo-react",
	"license": "MIT",
	"repository": "github:patrik-csak/eslint-config-xo-next",
	"author": "Patrik Csak <p@trikcsak.com> (https://patrikcsak.com)",
	"type": "module",
	"exports": {
		".": {
			"types": "./config.d.ts",
			"default": "./config.js"
		}
	},
	"sideEffects": false,
	"engines": {
		"node": "22 - 26"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "22 - 26"
		},
		"packageManager": {
			"name": "npm",
			"version": "12"
		}
	},
	"scripts": {
		"build": "tsc",
		"inspect": "eslint-config-inspector --config=config.js",
		"lint": "eslint",
		"prepack": "npm run build",
		"pretest": "npm run build",
		"test": "node --test",
		"test:coverage": "npm run test -- --experimental-test-coverage"
	},
	"files": [
		"config.js",
		"config.d.ts"
	],
	"keywords": [
		"eslint",
		"next",
		"next.js",
		"react",
		"xo"
	],
	"dependencies": {
		"globals": "^17.7.0",
		"ow": "^3.1.1",
		"tailwind-csstree": "^0.4.0"
	},
	"devDependencies": {
		"@eslint/config-inspector": "^3.0.4",
		"@next/eslint-plugin-next": "^16.2.10",
		"@tsconfig/node22": "^22.0.5",
		"@tsconfig/strictest": "^2.0.8",
		"@types/node": "^24.13.2",
		"eslint": "^10.6.0",
		"eslint-config-xo": "^5.0.0",
		"eslint-config-xo-react": "^0.32.0",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@next/eslint-plugin-next": "^16.0.0",
		"eslint": "^10.0.0",
		"eslint-config-xo-react": "^0.32.0"
	},
	"peerDependenciesMeta": {
		"eslint-config-xo-react": {
			"optional": true
		}
	},
	"allowScripts": {
		"unrs-resolver": false
	}
}
